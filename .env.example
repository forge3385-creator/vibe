# ============================================================================
# VIBE PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# Chapters 8, 14, 28, 30: Zero-Knowledge Architecture, Supabase & Spatial Mesh
# ============================================================================

# Fastify Server & Gateway
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# JWT Signing Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_64_character_hex_secret_in_production
JWT_EXPIRES_IN=7d

# Supabase Persistence & Authentication (PostgreSQL 16 + PostGIS)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Direct Connection String (Optional for Prisma / Drizzle / Migrations)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Mapping Provider Configuration (OpenStreetMap / CartoDB / Mapbox)
# Default is CartoDB Dark Matter / OSM (Free & No API key needed for standard evaluation)
MAP_PROVIDER=openstreetmap
# If using Mapbox GL or MapTiler:
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjbHhleGFtcGxlIn0.example
MAPTILER_API_KEY=your_maptiler_api_key_here

# Redis 7 Cache & Vibe Score Memoization (Optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Envelope Encryption Master Keys (AES-256-GCM / XChaCha20)
MASTER_KEY_ID=vibe_prod_kek_v1
ENCRYPTION_KEY_RING=replace_with_base64_encoded_32_byte_key

# Sound Design Settings
DEFAULT_SOUND_ENABLED=true
DEFAULT_SOUND_VOLUME=0.60

# Realtime WebSocket Gateway Subprotocol
VIBE_WS_SUBPROTOCOL=vibe.v1
